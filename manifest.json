{
  "manifest_version": 3,
  "name": "Marker Studio",
  "version": "1.1.1",
  "description": "Screen recording helpers: animated highlighter, spotlight zoom, smooth auto-scroll, clean mode and blur.",
  "permissions": ["storage"],
  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Marker Studio"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": [
        "shared.js",
        "content/zoom.js",
        "content/highlighter.js",
        "content/auto-scroll.js",
        "content/page-effects.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
